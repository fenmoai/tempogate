# Copy to `.env` (docker compose reads it automatically) and tweak if you
# like. Every value has a working default baked into docker-compose.yml, so
# the demo runs even with no .env at all.

# Email domains allowed to complete SSO. The demo identity below must match
# one of these or tempogate's callback returns 403 (that rejection is itself
# part of what the demo proves). Comma-separated, exact-match.
TEMPOGATE_ALLOWED_DOMAINS=example.com

# Identity the bundled mock IdP's one-click consent screen asserts. Change
# the local part freely; keep the domain inside TEMPOGATE_ALLOWED_DOMAINS.
DEMO_EMAIL=alice@example.com

# Shared secret promoting the Temporal Web UI to a confidential client (it
# does not implement PKCE). Used by BOTH tempogate (OIDC__CLIENT_SECRETS)
# and the temporal-ui container — they must stay equal. Demo value only;
# generate a real one for anything beyond this example.
TEMPORAL_UI_CLIENT_SECRET=local-temporal-ui-confidential-secret

# tempogate log level: debug | info | warn | error.
LOG_LEVEL=info
